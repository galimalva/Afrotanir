---
const { lang } = Astro.props;

import site from '../data/site.js';

const s = site[lang] || site.fa;

const ui = {
  fa: {
    dir: 'rtl', htmlLang: 'fa',
    btnTheme: 'تغییر تم سایت',
    storiesTitle: 'داستان‌ها', storyReadMore: 'ادامه داستان',
    langLink: '/en/', langText: 'English'
  },
  en: {
    dir: 'ltr', htmlLang: 'en',
    btnTheme: 'Toggle Theme',
    storiesTitle: 'Stories', storyReadMore: 'Read Story',
    langLink: '/', langText: 'فارسی'
  }
};

const t = { ...s, ...ui[lang] };

const icons = {
  email: '<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>',
  telegram: '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.68a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.54-.37-.62-.2-1.12-.31-1.08-.64.02-.18.28-.36.78-.54 2.44-1.06 4.07-1.76 4.89-2.1.45-.17.8-.3 1.05-.4.46-.2.88-.27 1.16-.16.07.02.14.06.2.12.06.07.09.16.08.3z"/>',
  instagram: '<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.817 1.713 4.965 4.965.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.248-1.718 4.817-4.965 4.965-1.265.058-1.645.069-4.849.069-3.204 0-3.584-.012-4.849-.069-3.26-.149-4.817-1.718-4.965-4.965-.058-1.265-.07-1.645-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.247 1.718-4.817 4.965-4.965 1.265-.058 1.644-.07 4.849-.07zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.272 2.695.072 7.053.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.277.058 1.686.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-10.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>',
  x: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>'
};

const storyModules = import.meta.glob('../data/stories/*.js', { eager: true });
const stories = Object.values(storyModules)
    .map((m) => m.default)
    .filter(Boolean)
    .sort((x, y) => (y.date || '').localeCompare(x.date || ''))
    .map((st) => ({
        title: st[lang]?.title || st.fa.title,
        desc: st[lang]?.desc || st.fa.desc,
        img: st.img || '',
        link: st.link || '#'
    }));
---

<html lang={t.htmlLang} dir={t.dir} data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{t.name} | {t.role}</title>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
        <script is:inline>
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        </script>
    </head>
    <body>
        <a href={t.langLink} class="lang-toggle" aria-label="Language Toggle">{t.langText}</a>

        <button id="theme-toggle" class="theme-toggle" aria-label={t.btnTheme}>
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>

        <div class="pattern-bg"></div>

        <main class="container">
            <div class="profile-card">
                <div class="profile-image-wrapper">
                    <img src={site.photo} alt={t.name} class="profile-img" />
                </div>

                <h1 class="name">{t.name}</h1>
                <h2 class="title">{t.role}</h2>

                <div class="about-me">
                    <h3 class="section-title">{t.aboutTitle}</h3>
                    <p class="about-text">{t.aboutText}</p>
                </div>

                {stories.length > 0 && (
                    <div class="stories-section">
                        <h3 class="section-title">{t.storiesTitle}</h3>
                        <div class="stories-grid">
                            {stories.map((story) => (
                                <a href={story.link} class="story-card">
                                    <div class="story-img-wrapper">
                                        <img src={story.img} alt={story.title} class="story-img" loading="lazy" />
                                    </div>
                                    <div class="story-info">
                                        <h4 class="story-title">{story.title}</h4>
                                        <div class="story-desc">
                                            {Array.isArray(story.desc) ? story.desc.map((p) => <p>{p}</p>) : story.desc}
                                        </div>
                                        <span class="story-read-more">{t.storyReadMore}</span>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )}

                <div class="social-links">
                    {site.social.map((item) => (
                        <a
                            href={item.url}
                            target={item.url.startsWith('mailto:') ? '_self' : '_blank'}
                            aria-label={item.type}
                            class="social-node"
                            set:html={`<svg viewBox="0 0 24 24">${icons[item.type] || ''}</svg>`}
                        />
                    ))}
                </div>
            </div>
        </main>
    </body>
</html>

<script is:inline>
    const html = document.documentElement;
    const toggleBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');

    const updateIcons = (theme) => {
        if (theme === 'dark') {
            sunIcon.style.display = 'block';
            moonIcon.style.display = 'none';
        } else {
            sunIcon.style.display = 'none';
            moonIcon.style.display = 'block';
        }
    };

    const currentTheme = html.getAttribute('data-theme') || 'dark';
    updateIcons(currentTheme);

    toggleBtn.addEventListener('click', () => {
        const newTheme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateIcons(newTheme);
    });
</script>

<style is:global>
    :root {
        --bg-main: #142B4A;
        --text-main: #EDE5DD;
        --accent-color: #C5A065;
        --border-color: #1A3B3D;
        --text-muted: #8FA3A5;
        --card-bg: rgba(12, 25, 26, 0.85);
    }

    [data-theme="light"] {
        --bg-main: #F4F1ED;
        --text-main: #142B4A;
        --accent-color: #A68B4B;
        --border-color: #D6D1CA;
        --text-muted: #6B7B7C;
        --card-bg: rgba(255, 255, 255, 0.7);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Vazirmatn', sans-serif;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        min-height: 100vh;
        overflow-x: hidden;
        transition: background-color 0.4s ease, color 0.4s ease;
    }

    .lang-toggle {
        position: fixed;
        top: 20px;
        left: 20px;
        z-index: 100;
        height: 50px;
        padding: 0 20px;
        border-radius: 25px;
        border: 1px solid rgba(33, 150, 243, 0.4);
        background-color: rgba(33, 150, 243, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 15px rgba(33, 150, 243, 0.25), inset 0 0 10px rgba(33, 150, 243, 0.1);
        color: #2196F3;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .lang-toggle:hover {
        background-color: rgba(33, 150, 243, 0.3);
        box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4), inset 0 0 15px rgba(33, 150, 243, 0.2);
        transform: scale(1.05);
        color: #2196F3;
    }

    .theme-toggle {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 100;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 1px solid rgba(33, 150, 243, 0.4);
        background-color: rgba(33, 150, 243, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 15px rgba(33, 150, 243, 0.25), inset 0 0 10px rgba(33, 150, 243, 0.1);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2196F3;
        transition: all 0.3s ease;
    }

    .theme-toggle:hover {
        background-color: rgba(33, 150, 243, 0.3);
        box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4), inset 0 0 15px rgba(33, 150, 243, 0.2);
        transform: scale(1.05);
    }

    #icon-moon { display: none; }

    .pattern-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background:
            linear-gradient(90deg, var(--border-color) 1px, transparent 1px),
            linear-gradient(0deg, var(--border-color) 2px, transparent 2px),
            var(--bg-main);
        background-size: 80px 100%, 100% 200px;
        opacity: 0.3;
        transition: background 0.4s ease;
    }

    .container {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
    }

    .profile-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 40px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        text-align: center;
        transition: background 0.4s ease, border-color 0.4s ease;
    }

    .profile-image-wrapper {
        width: 150px;
        height: 150px;
        margin: 0 auto 20px;
        border-radius: 50%;
        border: 3px solid var(--accent-color);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: border-color 0.4s ease;
    }

    .profile-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .name {
        font-size: 2.2rem;
        color: var(--text-main);
        margin-bottom: 8px;
        font-weight: 800;
    }

    .title {
        font-size: 1.2rem;
        color: var(--accent-color);
        font-weight: 400;
        letter-spacing: 1px;
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        transition: color 0.4s ease, border-color 0.4s ease;
    }

    .about-me {
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        text-align: center;
        transition: border-color 0.4s ease;
    }

    .about-text {
        font-size: 1.05rem;
        line-height: 2;
        color: var(--text-muted);
        transition: color 0.4s ease;
        max-width: 600px;
        margin: 0 auto;
    }

    .section-title {
        color: var(--text-main);
        font-size: 1.5rem;
        margin-bottom: 20px;
        text-align: center;
    }

    .stories-section {
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        transition: border-color 0.4s ease;
    }

    .stories-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .story-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: var(--text-main);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.4s ease, background 0.4s ease;
    }

    .story-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.25);
        border-color: var(--accent-color);
    }

    .story-img-wrapper {
        width: 100%;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-bottom: 1px solid var(--border-color);
    }

    .story-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .story-card:hover .story-img {
        transform: scale(1.08);
    }

    .story-info {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .story-title {
        font-size: 1.05rem;
        color: var(--accent-color);
        font-weight: 700;
        margin-bottom: 10px;
        transition: color 0.4s ease;
    }

    .story-desc {
        font-size: 0.88rem;
        line-height: 1.8;
        color: var(--text-muted);
        flex-grow: 1;
        transition: color 0.4s ease;
    }

    .story-desc p {
        margin-bottom: 10px;
    }

    .story-read-more {
        margin-top: 14px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--accent-color);
        transition: color 0.4s ease;
    }

    .story-read-more::after {
        content: '→';
        display: inline-block;
        margin-inline-start: 6px;
        transition: transform 0.3s ease;
    }

    [dir="rtl"] .story-read-more::after {
        content: '←';
    }

    .story-card:hover .story-read-more::after {
        transform: translateX(4px);
    }

    [dir="rtl"] .story-card:hover .story-read-more::after {
        transform: translateX(-4px);
    }

    /* --- شبکه‌های اجتماعی: فقط آیکن‌های درخشان، افقی --- */
    .social-links {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .social-node {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 30% 30%, #4da3ff, #1565c0);
        border: 2px solid rgba(33,150,243,0.7);
        box-shadow: 0 0 18px rgba(33,150,243,0.55), inset 0 0 10px rgba(255,255,255,0.25);
        color: #ffffff;
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .social-node svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
    }

    .social-node:hover {
        transform: scale(1.15) translateY(-3px);
        box-shadow: 0 0 30px rgba(33,150,243,0.9), inset 0 0 12px rgba(255,255,255,0.35);
    }

    @media (max-width: 600px) {
        .container {
            margin: 20px auto;
            padding: 15px;
        }
        .profile-card {
            padding: 25px;
        }
        .name {
            font-size: 1.8rem;
        }
        .stories-grid {
            grid-template-columns: 1fr;
        }
        .social-node {
            width: 30px;
            height: 30px;
        }
        .theme-toggle {
            top: 10px;
            right: 10px;
            width: 40px;
            height: 40px;
        }
        .lang-toggle {
            top: 10px;
            left: 10px;
            height: 40px;
            padding: 0 15px;
        }
    }
</style>